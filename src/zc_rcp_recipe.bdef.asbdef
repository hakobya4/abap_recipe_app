projection;
strict ( 2 );

define behavior for ZC_RCP_RECIPE alias Recipe
{


  use action importFromUrl;
  use action createRecipe;
  use action updateRecipe;
  use action deleteRecipe;


  use association _Ingredient;
  use association _Step;
}

define behavior for ZC_RCP_INGREDIENT alias Ingredient
{
  use action addIngredient;
  use action updateIngredient;
  use action deleteIngredient;
  use association _Recipe;
  use association _Uom;
  use association _TargetUom;
  use action toggleObtained;



}

define behavior for ZC_RCP_STEP alias Step
{

  use action addStep;
  use action updateStep;
  use action deleteStep;
  use association _Recipe;

}