projection;
strict ( 2 );
use draft;

define behavior for ZC_RCP_RECIPE alias Recipe
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Ingredient { create; with draft; }
  use association _Step { create; with draft; }
}

define behavior for ZC_RCP_INGREDIENT alias Ingredient
{
  use update;
  use delete;

  use association _Recipe { with draft; }
  use association _Uom;
  use association _TargetUom;
  use action toggleObtained;



}

define behavior for ZC_RCP_STEP alias Step
{
  use update;
  use delete;

  use association _Recipe { with draft; }

}