@Metadata.layer: #CORE
@UI.headerInfo:{
    typeName:       'Session',
    typeNamePlural: 'Sessions',
    title:{ type: #STANDARD, value: 'SessionUuid' }
}
annotate entity ZC_AUTH_SESS with
{

  @UI.facet: [
    {
      id: 'SessionDetails', purpose: #STANDARD,
      type: #FIELDGROUP_REFERENCE, label: 'Session Details',
      position: 10, targetQualifier: 'SessionDetails'
    }
  ]
  @UI.lineItem: [
    { position: 10, label: 'User' },
    { position: 45, label: 'Logout', type: #FOR_ACTION, dataAction: 'logout' }
  ]
  @UI.fieldGroup: [{ qualifier: 'SessionDetails', position: 10, label: 'User' }]
  UserUuid;

  @UI.lineItem:   [{ position: 20, label: 'Created At' }]
  @UI.fieldGroup: [{ qualifier: 'SessionDetails', position: 20, label: 'Created At' }]
  CreatedAt;

  @UI.lineItem:   [{ position: 30, label: 'Expires At' }]
  @UI.fieldGroup: [{ qualifier: 'SessionDetails', position: 30, label: 'Expires At' }]
  ExpiresAt;
}